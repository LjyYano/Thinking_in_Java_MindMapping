---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign articles = site.pages | where_exp: 'item', 'item.date != nil' %}
  {% for article in articles %}
  <url>
    <loc>{{ article.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ article.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  <url><loc>{{ '/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/archive/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/about/' | absolute_url | xml_escape }}</loc></url>
  {% for category in site.data.categories %}
  <url><loc>{{ '/categories/' | append: category.slug | append: '/' | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
</urlset>
