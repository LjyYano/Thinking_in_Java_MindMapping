---
layout: null
permalink: /search.json
---
{% assign articles = site.pages | where_exp: 'item', 'item.date != nil' | sort: 'date' | reverse %}
[
{% for article in articles %}
  {% assign article_title = article.title | default: article.name | replace: '.md', '' %}
  {% assign parts = article.path | split: '/' %}
  {
    "title": {{ article_title | jsonify }},
    "url": {{ article.url | relative_url | jsonify }},
    "category": {{ parts[0] | jsonify }},
    "date": {{ article.date | date: '%Y.%m.%d' | jsonify }},
    "excerpt": {{ article.content | strip_html | strip_newlines | normalize_whitespace | truncate: 240 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
